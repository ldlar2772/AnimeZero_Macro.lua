local function findAndClickButton(patterns)
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return false, "Sem PlayerGui" end

    local candidates = {}
    for _, gui in pairs(pg:GetChildren()) do
        if gui:IsA("ScreenGui") and gui.Enabled then
            for _, v in pairs(gui:GetDescendants()) do
                if (v:IsA("TextButton") or v:IsA("ImageButton")) and v.Visible then
                    local n = string.lower(v.Name)
                    local txt = ""
                    if v:IsA("TextButton") then txt = string.lower(v.Text or "") end
                    for _, pat in ipairs(patterns) do
                        if string.find(n, pat) or string.find(txt, pat) then
                            if v.AbsoluteSize.X > 1 and v.AbsoluteSize.Y > 1 then
                                table.insert(candidates, v)
                            end
                            break
                        end
                    end
                end
            end
        end
    end
    if #candidates == 0 then return false, "Nenhum botão bateu" end

    local btn = candidates[1]
    for _, c in ipairs(candidates) do
        if c.AbsoluteSize.Magnitude > btn.AbsoluteSize.Magnitude then btn = c end
    end

    for _ = 1, 3 do
        local fired = false
        pcall(function()
            if firesignal then
                firesignal(btn.Activated)
                fired = true
            end
        end)
        if not fired then
            local px = btn.AbsolutePosition.X + btn.AbsoluteSize.X / 2
            local py = btn.AbsolutePosition.Y + btn.AbsoluteSize.Y / 2
            VirtualInputManager:SendMouseButtonEvent(px, py, 0, true, game, 1)
            task.wait(0.05)
            VirtualInputManager:SendMouseButtonEvent(px, py, 0, false, game, 1)
        end
        task.wait(0.3)
    end
    return true, btn:GetFullName() .. " (" .. #candidates .. ")"
end

