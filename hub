task.spawn(function()
    while task.wait(0.1) do  -- 🔑 loop um pouco mais lento porque agora anda
        if not currentTarget then continue end
        if not (getgenv().AutoFarm or getgenv().AutoBarrier) then continue end
        local char = LocalPlayer.Character
        local root, hum = getRoot(char), getHum(char)
        if not root or not hum or hum.Health <= 0 then continue end
        local myPos = root.Position

        if targetType == "Enemy" then
            -- Inimigo: continua TP direto (rápido)
            if not currentTarget.Parent then continue end
            local targetPos = currentTarget.Position
            local desired = currentTarget.CFrame * CFrame.new(0, 0, 2.5)
            if (myPos - desired.Position).Magnitude > 2 then
                teleportTo(desired.Position, targetPos)
            end
        elseif targetType == "Waypoint" then
            -- 🔑 Waypoint: ANDA em vez de teleportar
            stepTeleport(currentTarget, TP_STEP_SIZE)
        elseif targetType == "Barrier" then
            if not currentTarget.Parent then continue end
            local targetPos = currentTarget.Position
            local distToTarget = (myPos - targetPos).Magnitude
            if distToTarget > TP_NEAR_DIST then
                -- Ainda longe da barreira: anda
                stepTeleport(targetPos, TP_STEP_SIZE)
            else
                -- Perto: posiciona
                local dir = myPos - targetPos
                if dir.Magnitude < 0.5 then dir = Vector3.new(0, 0, 1) else dir = dir.Unit end
                local idealPos = targetPos + dir * 5
                if (myPos - idealPos).Magnitude > 2 then
                    teleportTo(idealPos, targetPos)
                end
            end
        end
    end
end)

-- ==========================================
-- PATROL
-- ==========================================
local patrolHome   = nil
local patrolAngle  = 0
local patrolRadius = 15
local lastEnemyPos = nil

task.spawn(function()
    while task.wait(0.4) do
        if not (getgenv().AutoFarm or getgenv().AutoBarrier) then
            patrolHome = nil; patrolAngle = 0; patrolRadius = 15; lastEnemyPos = nil
            continue
        end
        if currentTarget then
            if targetType == "Enemy" then lastEnemyPos = currentTarget.Position end
            continue
        end
        if not getgenv().AutoPatrol then continue end

        local char = LocalPlayer.Character
        local root, hum = getRoot(char), getHum(char)
        if not root or not hum or hum.Health <= 0 then continue end
        if not patrolHome then patrolHome = root.Position end
        local base = lastEnemyPos or patrolHome
        patrolAngle  = patrolAngle + 0.5
        patrolRadius = patrolRadius + 3
        if patrolRadius > 200 then patrolRadius = 15 end
        local px = base.X + math.cos(patrolAngle) * patrolRadius
        local pz = base.Z + math.sin(patrolAngle) * patrolRadius
        teleportTo(Vector3.new(px, base.Y, pz), base)
    end
end)

-- ==========================================
-- ATAQUE M1
-- ==========================================
local function doAttack(targetPos)
    local cam = workspace.CurrentCamera
    local x, y
    if targetPos then
        local sp, onScreen = cam:WorldToViewportPoint(targetPos)
        if onScreen then x, y = sp.X, sp.Y end
    end
    if not x or not y then
        x = cam.ViewportSize.X / 2
        y = cam.ViewportSize.Y / 2
    end
    VirtualInputManager:SendMouseButtonEvent(x, y, 0, true,  game, 1)
    task.wait(0.03)
    VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
end

task.spawn(function()
    while task.wait(0.05) do
        local active = getgenv().AutoFarm
                    or (getgenv().AutoBarrier and currentTarget)
        if not active then continue end
        if targetType == "Waypoint" then continue end
        if shouldPauseAttacks() then continue end

        local char = LocalPlayer.Character
        local hum  = getHum(char)
        if not hum or hum.Health <= 0 then continue end

        local delay = getgenv().AttackDelay or 0.4
        if tick() - lastAttack < delay then continue end

        local aimPos = nil
        if currentTarget and currentTarget.Parent then
            if targetType == "Barrier" then
                local myRoot = getRoot(char)
                if myRoot then
                    local d = (myRoot.Position - currentTarget.Position).Magnitude
                    if d > ATTACK_MAX_DIST then continue end
                end
            end
            aimPos = currentTarget.Position
            lastAimPos = aimPos
        elseif getgenv().AutoFarm and lastAimPos then
            aimPos = lastAimPos
        else
            aimPos = nil
        end

        lastAttack = tick()
        doAttack(aimPos)
    end
end)

