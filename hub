-- ==========================================
-- DETECÇÃO DE ALVOS
-- ==========================================
task.spawn(function()
    while task.wait(0.3) do
        local char = LocalPlayer.Character
        local root = getRoot(char)
        if not root or not (getgenv().AutoFarm or getgenv().AutoBarrier) then
            currentTarget, targetType = nil, nil
            continue
        end
        local myPos = root.Position
        local foundEnemy = false

        if getgenv().AutoFarm then
            local enemiesFolder = workspace:FindFirstChild("enemies")
            local bestEnemy, bestDist = nil, math.huge
            local searchIn = enemiesFolder and enemiesFolder:GetChildren() or workspace:GetChildren()
            for _, v in pairs(searchIn) do
                if v:IsA("Model") and v ~= char and not Players:GetPlayerFromCharacter(v) then
                    local vRoot, vHum = getRoot(v), getHum(v)
                    if vRoot and vHum and vHum.Health > 0 then
                        if not isTooDeep(vRoot.Position, myPos) then
                            local d = (myPos - vRoot.Position).Magnitude
                            if d < bestDist and d < 500 then
                                bestEnemy, bestDist = vRoot, d
                            end
                        end
                    end
                end
            end
            if bestEnemy then
                if currentTarget ~= bestEnemy then
                    currentPath = nil; currentPathTarget = nil; currentPathIndex = 1
                end
                currentTarget, targetType = bestEnemy, "Enemy"
                lastAimPos = bestEnemy.Position
                foundEnemy = true
            end
        end
        if foundEnemy then continue end

        if getgenv().AutoBarrier and #waypoints > 0 then
            local enemiesAlive = aliveEnemiesCount()
            if enemiesAlive == 0 then
                local wp = waypoints[currentWpIndex]
                if wp then
                    local distToWp = (myPos - wp).Magnitude
                    if not waypointReached and distToWp < WP_REACHED_DIST then
                        waypointReached = true
                    end
                    if waypointReached then
                        local rubble = findRubbleNear(wp, 40)
                        if rubble then
                            if currentTarget ~= rubble then
                                currentPath = nil; currentPathTarget = nil; currentPathIndex = 1
                            end
                            currentTarget, targetType = rubble, "Barrier"
                            lastAimPos = rubble.Position
                        else
                            waypointReached = false
                            if currentWpIndex >= #waypoints then
                                -- 🔑 FIM DO LOOP: executa ação e reinicia do waypoint MAIS PRÓXIMO
                                local action = getgenv().EndAction or "Nada (parar)"
                                if action ~= "Nada (parar)" then
                                    Rayfield:Notify({Title = "Auto Barrier", Content = "Waypoints concluídos! Ação: " .. tostring(action), Duration = 5, Image = 4483362458})
                                    handleEndAction()
                                end
                                currentWpIndex = findClosestWpIndex()
                            else
                                currentWpIndex = currentWpIndex + 1
                            end
                            currentPath = nil; currentPathTarget = nil; currentPathIndex = 1
                        end
                    else
                        if currentTarget ~= wp then
                            currentPath = nil; currentPathTarget = nil; currentPathIndex = 1
                        end
                        currentTarget, targetType = wp, "Waypoint"
                    end
                else
                    currentWpIndex = 1; waypointReached = false
                    currentTarget, targetType = nil, nil
                end
            else
                if not getgenv().AutoFarm then currentTarget, targetType = nil, nil end
            end
        else
            if not getgenv().AutoFarm then currentTarget, targetType = nil, nil end
        end
    end
end)

