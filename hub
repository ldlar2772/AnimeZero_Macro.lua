local cachedHub = nil
local function findRayfieldGui()
    if cachedHub and cachedHub.Parent then return cachedHub end
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return nil end
    for _, g in pairs(pg:GetChildren()) do
        if g:IsA("ScreenGui") then
            for _, c in pairs(g:GetDescendants()) do
                if c:IsA("TextLabel") and (c.Text == WINDOW_NAME or string.find(c.Text or "", "GGM HUB")) then
                    cachedHub = g
                    return g
                end
            end
        end
    end
    return nil
end

local function isMouseOverHub()
    local rg = findRayfieldGui()
    if not rg or not rg.Enabled then return false end
    local mloc = UserInputService:GetMouseLocation()
    for _, v in pairs(rg:GetDescendants()) do
        if (v:IsA("GuiButton") or v:IsA("TextBox") or v:IsA("ScrollingFrame")) and v.Visible then
            local p, s = v.AbsolutePosition, v.AbsoluteSize
            if mloc.X >= p.X and mloc.X <= p.X + s.X
               and mloc.Y >= p.Y and mloc.Y <= p.Y + s.Y then
                return true
            end
        end
    end
    return false
end

local function isTyping()
    return UserInputService:GetFocusedTextBox() ~= nil
end

local function shouldPauseAttacks()
    return isTyping() or isMouseOverHub()
end

local function readConfigNameFromUI()
    local ok1, v1 = pcall(function()
        if Rayfield and Rayfield.Flags then return Rayfield.Flags[INPUT_FLAG] end
    end)
    if ok1 and type(v1) == "string" and v1 ~= "" then return v1 end
    local focused = UserInputService:GetFocusedTextBox()
    if focused and focused.Text and focused.Text ~= "" then return focused.Text end
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if pg then
        for _, d in pairs(pg:GetDescendants()) do
            if d:IsA("TextBox") then
                local ph = d.PlaceholderText or ""
                if string.find(ph, "Fase1") or string.find(ph, "Config") then
                    if d.Text and d.Text ~= "" and d.Text ~= ph then return d.Text end
                end
            end
        end
    end
    return lastConfigName
end

