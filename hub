-- HELPERS
-- ==========================================
local function getRoot(c) return c and c:FindFirstChild("HumanoidRootPart") end
local function getHum(c)  return c and c:FindFirstChildOfClass("Humanoid") end

local function teleportTo(targetPos, lookAtPos)
    if tick() - lastTP < 0.03 then return false end
    lastTP = tick()
    local char = LocalPlayer.Character
    local root = getRoot(char)
    if not root then return false end
    root.Anchored = true
    root.CFrame = CFrame.new(targetPos, lookAtPos)
    root.Velocity = Vector3.zero
    root.RotVelocity = Vector3.zero
    root.Anchored = false
    return true
end

-- Encontra o índice do waypoint mais próximo do player
local function findClosestWpIndex()
    local root = getRoot(LocalPlayer.Character)
    if not root or #waypoints == 0 then return 1 end
    local myPos = root.Position
    local bestIdx, bestDist = 1, math.huge
    for i, wp in ipairs(waypoints) do
        local d = (myPos - wp).Magnitude
        if d < bestDist then
            bestIdx, bestDist = i, d
        end
    end
    return bestIdx
end

-- ==========================================
-- PATHFINDING
-- ==========================================
local function computePath(startPos, endPos)
    local path = PathfindingService:CreatePath({
        AgentRadius = 3,
        AgentHeight = 6,
        AgentCanJump = true,
        AgentCanClimb = false,
        AgentMaxSlope = 45,
        WaypointSpacing = 7,  -- 🔑 7 studs
    })
    local ok = pcall(function()
        path:ComputeAsync(startPos, endPos)
    end)
    if not ok or path.Status ~= Enum.PathStatus.Success then
        return nil
    end
    return path:GetWaypoints()
end

local function getPath(targetPos)
    local char = LocalPlayer.Character
    local root = getRoot(char)
    if not root then return nil, nil end

    if currentPath and currentPathTarget then
        if (currentPathTarget - targetPos).Magnitude < 5 and (tick() - currentPathTime) < 2 then
            return currentPath, currentPathIndex
        end
    end

    local wps = computePath(root.Position, targetPos)
    if not wps or #wps == 0 then return nil, nil end

    currentPath = wps
    currentPathIndex = 1
    currentPathTarget = targetPos
    currentPathTime = tick()
    return currentPath, currentPathIndex
end

local function hasObstacle(fromPos, toPos)
    local char = LocalPlayer.Character
    if not char then return false end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {char}
    params.IgnoreWater = true
    for _, h in ipairs({0, 2, 4}) do
        local o = fromPos + Vector3.new(0, h, 0)
        local t = toPos   + Vector3.new(0, h, 0)
        if workspace:Raycast(o, t - o, params) then return true end
    end
    return false
end

-- 🔑 AGORA ANDA em vez de teleportar
local function stepTeleport(targetPos, stepSize)
    stepSize = stepSize or TP_STEP_SIZE
    local char = LocalPlayer.Character
    local root = getRoot(char)
    local hum = getHum(char)
    if not root or not hum then return false end
    local myPos = root.Position

    local flatTarget = Vector3.new(targetPos.X, myPos.Y, targetPos.Z)
    local directDist = (flatTarget - myPos).Magnitude

    -- Detecção de travamento
    if lastPosition then
        local moved = (myPos - lastPosition).Magnitude
        if moved < 0.3 then
            stuckCounter = stuckCounter + 1
        else
            stuckCounter = 0
        end
    end
    lastPosition = myPos

    -- Anti-stuck: se travar, teleporta 7 studs pra frente + sobe um pouco
    if stuckCounter >= STUCK_THRESHOLD and tick() - lastUnstuck > 2 then
        lastUnstuck = tick()
        stuckCounter = 0
        local dir = (flatTarget - myPos)
        if dir.Magnitude > 0.1 then
            dir = dir.Unit
            local nextPos = myPos + dir * stepSize + Vector3.new(0, 6, 0)
            teleportTo(nextPos, targetPos)
        else
            teleportTo(myPos + Vector3.new(0, 8, 0), targetPos)
        end
        return true
    end

    -- Chegou perto → OK
    if directDist < 3 then
        return true
    end

    -- Sem obstáculo → anda direto
    if not hasObstacle(myPos, flatTarget) then
        pcall(function() hum:MoveTo(flatTarget) end)
        return true
    end

    -- Com obstáculo → pathfinding
    local path, idx = getPath(targetPos)
    if not path then
        pcall(function() hum:MoveTo(flatTarget) end)
        return true
    end

    if idx > #path then
        currentPath = nil
        currentPathTarget = nil
        return false
    end

    idx = math.clamp(idx, 1, #path)
    local wp = path[idx]
    local wpPos = wp.Position

    -- Sanity check
    local wpToTarget = (Vector3.new(targetPos.X, wpPos.Y, targetPos.Z) - wpPos).Magnitude
    if wpToTarget > directDist + 8 then
        currentPath = nil
        currentPathTarget = nil
        currentPathIndex = 1
        pcall(function() hum:MoveTo(flatTarget) end)
        return true
    end

    -- Pula waypoints já alcançados
    while (myPos - wpPos).Magnitude < 3 and idx < #path do
        idx = idx + 1
        wp = path[idx]
        wpPos = wp.Position
    end
    currentPathIndex = idx

    pcall(function() hum:MoveTo(wpPos) end)
    return true
end

